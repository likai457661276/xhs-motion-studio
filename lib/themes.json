  "styles": {
    "editorial-paper": {
      "label": "编辑纸张风",
      "en": "Editorial paper",
      "theme": "editorial-amber",
      "background": "paper",
      "grain": true,
      "grainInk": 0.07,
      "shadow": "soft",
      "misregister": 0,
      "cardRadius": 28,
      "note": "暖纸底 + 流动纸纹 + 细颗粒 + 柔和投影，杂志排版感"
    },
    "flat-illustration": {
      "label": "扁平插画风",
      "en": "Clean flat illustration",
      "theme": "flat-pop",
      "background": "flat",
      "grain": false,
      "grainInk": 0,
      "shadow": "flat",
      "misregister": 0,
      "cardRadius": 40,
      "note": "干净浅底 + 大色块圆形 + 无颗粒 + 实色描边，扁平插画感"
    },
    "riso-print": {
      "label": "孔版印刷风",
      "en": "Risograph / halftone print",
      "theme": "riso-ink",
      "background": "halftone",
      "grain": true,
      "grainInk": 0.12,
      "shadow": "offset",
      "misregister": 3,
      "cardRadius": 18,
      "note": "米色纸 + 网点 + 荧光粉/蓝双色套印错位 + 硬投影，印刷品质感"
    }
  },
  "styleOrder": [
    "editorial-paper",
    "flat-illustration",
    "riso-print"
  ]
